# systemd **system** unit, for an always-on host.
#
# preferred over the user unit on a server: it starts at boot without anyone
# logging in and without `loginctl enable-linger`.
#
#   sudo useradd --system --home /var/lib/metermate --create-home metermate
#   sudo cp -r target/release/metermate models /var/lib/metermate/
#   sudo cp metermate.local.toml /var/lib/metermate/
#   sudo chown -R metermate: /var/lib/metermate
#   sudo chmod 600 /var/lib/metermate/metermate.local.toml   # camera credentials
#
#   sudo cp contrib/metermate-system.service /etc/systemd/system/metermate.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now metermate
#   journalctl -u metermate -f

[Unit]
Description=metermate parking enforcement watcher
Documentation=https://github.com/khimaros/metermate
After=network-online.target
Wants=network-online.target

# never stop trying. the default is to give up after 5 restarts in 10s, which
# for a service meant to run unattended for weeks is exactly backwards: a camera
# rebooting or wifi dropping is the normal case this is built to survive, and
# giving up permanently turns a transient fault into silent downtime (r5.1).
StartLimitIntervalSec=0

[Service]
Type=simple
User=metermate
Group=metermate

# the binary resolves models/, data/ and metermate.local.toml relative to here.
WorkingDirectory=/var/lib/metermate
ExecStart=/var/lib/metermate/metermate

Environment=RUST_LOG=metermate=info

Restart=always
RestartSec=5

# r3.3 caps steady-state memory at 1 GB. stated as limits rather than hopes:
# MemoryHigh throttles and reclaims, so a slow leak shows up as pressure in the
# journal, and MemoryMax is the hard stop.
#
# **this cgroup holds the ffmpeg children too.** measured on the deployment:
# 652 MB steady, 860 MB peak -- metermate 439 MB, main-stream ffmpeg 191 MB,
# gate ffmpeg 108 MB. the old note here said 155 MB peaking near 300, which was
# true before the crop feed decoded 2560x1440.
#
# MemoryHigh was 768M, and what happens when it is crossed is worth knowing,
# because nothing about it looks like memory. the kernel does not kill anything;
# it throttles every allocation into direct reclaim. the service was throttled
# 165,334 times, `sock_throttled` throttled the rtsp receive path itself, and the
# main stream then delivered nothing for ten seconds at a stretch, every
# forty-five seconds, with no error logged anywhere and the cpu idle. it reads as
# a camera fault, or a detector fault, or anything but a memory limit.
#
# so the soft limit sits close to the hard one: it exists to catch a leak, and a
# cliff 100 MB below the ceiling catches ordinary variation instead.
MemoryHigh=960M
MemoryMax=1G

# r3.1 caps idle cost at 30% of one core, measured at 4%. this is far above
# that, because the detector is allowed to burst while a vehicle is in frame and
# throttling it would drop the frames the vehicle is in. it exists to stop a
# runaway, not to enforce the idle budget.
#
# it does bound `[detector] threads`, though: 200% is two cores, so asking onnx
# for eight buys nothing here and the extra threads simply contend. raise this
# first if raising that.
CPUQuota=200%

# the harvest deletes its own oldest crops to stay inside its budget (r6.4), so
# this is a second line of defence rather than the first: if that ever fails, a
# full disk would take the alert path down with it.
StateDirectory=metermate

ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/metermate
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectClock=true
ProtectHostname=true
NoNewPrivileges=true
# it binds 8420, which needs no privilege, and spawns ffmpeg, which needs none
# either. so it needs no capabilities at all.
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# rtsp to the camera, mqtt to the broker, tcp for the preview server.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
